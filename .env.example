# =============================================================================
# Plataforma de Planificación y Gestión Integrada de Riesgos
# Variables de entorno para Cloudflare
# =============================================================================

# --- Cloudflare Account ---
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_D1_DATABASE_ID=""

# --- Autenticación ---
AUTH_SECRET="your-super-secret-key-here-generate-with-openssl-rand-base64-32"

# --- ClaveÚnica (Autenticación ciudadana Chile) ---
CLAVEUNICA_CLIENT_ID=""
CLAVEUNICA_CLIENT_SECRET=""
CLAVEUNICA_REDIRECT_URI="https://your-domain.pages.dev/api/auth/callback/claveunica"

# --- Integraciones Gobierno de Chile ---
# API SINAPACC (Ministerio del Medio Ambiente)
SINAPACC_API_URL="https://api.sinapacc.mma.gob.cl"
SINAPACC_API_KEY=""

# API SENAPRED (Sistema Nacional de Emergencias)
SENAPRED_API_URL="https://api.senapred.gob.cl"
SENAPRED_API_KEY=""

# API Mercado Público (Licitaciones)
MERCADOPUBLICO_API_URL="https://api.mercadopublico.cl"
MERCADOPUBLICO_API_KEY=""

# IDE Chile (Infraestructura de Datos Espaciales)
IDE_CHILE_WMS_URL="https://www.ide.cl/geoserver/wms"
IDE_CHILE_WFS_URL="https://www.ide.cl/geoserver/wfs"

# ARClim (Atlas de Riesgos Climáticos)
ARCLIM_API_URL="https://arclim.mma.gob.cl/api"

# --- Mapas ---
MAPBOX_ACCESS_TOKEN=""

# --- Modo ---
ENVIRONMENT="development"
