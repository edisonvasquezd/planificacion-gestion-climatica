{
  "name": "planificacion-gestion-platform",
  "version": "1.0.0",
  "description": "Plataforma Web para Planificación y Gestión Integrada de Riesgos Climáticos",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "drizzle-kit generate",
    "cf:dev": "wrangler dev src/worker/index.ts",
    "cf:deploy": "wrangler deploy src/worker/index.ts",
    "pages:build": "npx @opennextjs/cloudflare build && node scripts/prepare-deploy.js",
    "pages:deploy": "npx wrangler pages deploy .deploy --project-name=planificacion-gestion --config wrangler.pages.toml",
    "pages:preview": "npx @opennextjs/cloudflare dev"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.21",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "drizzle-orm": "^0.33.0",
    "hono": "^4.5.0",
    "leaflet": "1.9",
    "lucide-react": "^0.562.0",
    "next": "^14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-leaflet": "^4.2.1",
    "tailwind-merge": "^2.4.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240806.0",
    "@opennextjs/cloudflare": "^1.14.8",
    "@types/node": "^20.14.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.19",
    "drizzle-kit": "^0.24.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.0",
    "wrangler": "^4.59.2"
  }
}
